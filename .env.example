VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_BACKEND_URL=http://localhost:3001
VITE_ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# Server-only Cloudflare R2 credentials; never use the VITE_ prefix for these.
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ENDPOINT=https://YOUR_R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=store-media
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Leave false while verifying the R2 migration; enables Supabase media deletion.
SUPABASE_MEDIA_CLEANUP_ENABLED=false
