{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "node --env-file-if-exists=.env.server --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "compress-images": "node scripts/compress-old-images.mjs",
    "media:migrate:compress": "node --env-file=.env.server scripts/compress-store-media.mjs",
    "media:migrate:r2": "node scripts/migrate-supabase-to-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "dotenv": "^18.0.10",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
